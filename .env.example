# Groq API key for /api/chat (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Upstash Redis (admin panel, bot settings, rate limiting).
# The Vercel Marketplace integration injects KV_REST_API_URL / KV_REST_API_TOKEN;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_token_here

# Admin panel auth
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_JWT_SECRET=long_random_string_at_least_32_chars

# Resend email logging for /api/log-chat (optional)
RESEND_API_KEY=re_your_resend_api_key_here
CHAT_LOG_TO=you@example.com
CHAT_LOG_FROM=Portfolio Chat <onboarding@resend.dev>

# Sentry error + performance monitoring (optional; disabled when empty)
VITE_SENTRY_DSN=
